# Copy this file to `.env` and adjust it. Never commit the real `.env`.
# Loaded automatically by config/settings.py when python-dotenv is installed.

# --- Security -----------------------------------------------------------
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
# Never enable DEBUG in production.
DJANGO_DEBUG=True
# Comma separated list of host names the app is served on.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Localisation -------------------------------------------------------
# Default UI language: en or zh-hans
DJANGO_LANGUAGE_CODE=en
# Let the browser Accept-Language header decide the language (default: off)
DJANGO_LANGUAGE_FROM_BROWSER=False
